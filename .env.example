# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/prompt_version_history
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/prompt_version_history_test

# ──────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────
# Must be at least 32 characters — generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_32_char_minimum_secret_string
JWT_REFRESH_SECRET=change_me_to_a_different_random_32_char_secret_string
# Access token TTL in seconds (default: 900 = 15 minutes)
JWT_EXPIRES_IN=900
# Refresh token TTL in seconds (default: 604800 = 7 days)
JWT_REFRESH_EXPIRES_IN=604800

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Frontend origin for CORS whitelist
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────
# Frontend (Vite — must be prefixed VITE_)
# ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001/api
